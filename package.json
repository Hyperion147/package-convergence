{
  "name": "@Hyperion147/convergence-ui",
  "version": "2.0.0",
  "description": "A headless OKLCH theme engine and React editor for semantic design tokens, Tailwind v4 themes, and modern React apps.",
  "license": "MIT",
  "author": "Hyperion147",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc",
    "ship": "npm publish --access public && npm publish --registry=https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.8",
    "culori": "^4.0.2",
    "react": "^19.2.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperion147/package-convergence.git"
  },
  "keywords": [
    "react",
    "theme",
    "design-tokens",
    "generator",
    "oklch",
    "css-variables",
    "design-system",
    "color-palette",
    "tailwind-v4",
    "theme-editor",
    "ui-tool",
    "react-theme"
  ],
  "bugs": {
    "url": "https://github.com/Hyperion147/package-convergence/issues"
  },
  "homepage": "https://github.com/Hyperion147/package-convergence#readme",
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "lucide-react": "^0.562.0"
  }
}